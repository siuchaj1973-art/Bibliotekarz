# --- Bibliotekarz configuration ---

# TCP port for the HTTP server
PORT=4321

# Directory that holds your ebook & audiobook files.
# The scanner reads (never modifies) files under this path.
LIBRARY_DIR=./library

# Directory where Bibliotekarz stores its database and extracted covers.
DATA_DIR=./data

# Public base URL (used for OPDS feeds). Leave empty to auto-derive from request.
PUBLIC_BASE_URL=

# Optional shared-secret token. When set, every /api and /opds request must send
# either "Authorization: Bearer <token>" or "?token=<token>". Leave empty to disable auth
# (safe for a trusted LAN / localhost). Set it when exposing Bibliotekarz to the internet.
AUTH_TOKEN=

# Run an incremental library scan on startup (true/false). Cheap thanks to
# hash-based change detection; keeps the catalog fresh after restarts.
SCAN_ON_START=true

# Log level: debug | info | warn | error
LOG_LEVEL=info
